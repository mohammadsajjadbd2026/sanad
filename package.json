{
  "name": "sanad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "eval": "tsx --conditions=react-server scripts/eval.ts",
    "triage": "tsx --conditions=react-server scripts/triage.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "embeddings:plan": "tsx --conditions=react-server scripts/build-embeddings.ts --plan",
    "embeddings:sample": "tsx --conditions=react-server scripts/build-embeddings.ts --sample 20",
    "embeddings:build": "tsx --conditions=react-server scripts/build-embeddings.ts",
    "env:check": "tsx scripts/check-env.ts",
    "test:smoke": "tsx --test tests/smoke/*.test.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "latest",
    "@google/genai": "^2.27.0",
    "@next/env": "^16.3.8",
    "lucide-react": "latest",
    "mammoth": "^1.13.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}

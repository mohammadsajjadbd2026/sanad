# Server-only. Never prefix these variables with NEXT_PUBLIC_.
# Phase 1 runs without any API key. Later phases use Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RUNTIME_ENABLED=false
# Set true only for a key whose Google project is Free tier with billing disabled.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIMENSIONS=768
DORAR_LIVE=false
# Read-only external library providers. False disables a provider. User consent still required.
KHIZANA_ENABLED=true
ISLAMHOUSE_ENABLED=true
# Optional override; otherwise the documented public IslamHouse v3 key is used server-side.
ISLAMHOUSE_API_KEY=
